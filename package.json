{
  "name": "crumbs",
  "displayName": "Crumbs",
  "description": "Open Packet Traces (Pcaps) in Visual Studio Code.",
  "version": "1.0.0",
  "publisher": "lukaschneider",
  "icon": "icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lukaschneider/Crumbs"
  },
  "bugs": {
    "url": "https://github.com/lukaschneider/Crumbs/issues"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "crumbsFrameList",
        "displayName": "Frame List",
        "selector": [
          {
            "filenamePattern": "*.cap*"
          },
          {
            "filenamePattern": "*.pcap*"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "crumbsFrameExplorer",
          "title": "Frame Explorer",
          "icon": "$(telescope)"
        }
      ]
    },
    "views": {
      "crumbsFrameExplorer": [
        {
          "id": "crumbsFrameTree",
          "contextualTitle": "Frame Explorer",
          "name": "Tree",
          "icon": "$(list-tree)",
          "type": "tree",
          "when": "openDocumentCount > 0"
        },
        {
          "id": "crumbsFrameHex",
          "contextualTitle": "Frame Explorer",
          "name": "Hex",
          "icon": "$(file-binary)",
          "type": "webview",
          "when": "openDocumentCount > 0"
        }
      ]
    },
    "configuration": [
      {
        "title": "Crumbs",
        "properties": {
          "crumbs.sharkd": {
            "type": "string",
            "default": "sharkd",
            "description": "Path to the sharkd binary.",
            "scope": "machine"
          },
          "crumbs.wireshark": {
            "type": "string",
            "default": "wireshark",
            "description": "Path to the wireshark binary.",
            "scope": "machine"
          },
          "crumbs.profile": {
            "type": "string",
            "default": "Default",
            "description": "The wireshark profile to use.",
            "scope": "machine"
          },
          "crumbs.frameList.columns": {
            "type": "object",
            "default": null,
            "examples": [
              {
                "Number": "%m",
                "Time": "%t",
                "Source": "%s",
                "Destination": "%d",
                "Protocol": "%p",
                "Length": "%L",
                "Info": "%i"
              }
            ],
            "markdownDescription": "The columns to be displayed in the frame list. If nothing is set default columns are used.\n\n**Note:** Run `tshark -G column-formats` to see available field types or use a display filter field. See available fields here: https://www.wireshark.org/docs/dfref/. If you need to add field occurrence you can do so by adding \":`occurrence`\".",
            "additionalProperties": {
              "type": "string",
              "description": "Key is the column title and value is the field type or expression."
            }
          },
          "crumbs.frameList.colorCoding": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Use Wiresharks row coloring rules.\n\n**Note:** Might not work ideal with some color themes!"
          },
          "crumbs.frameHex.enableRowWrap": {
            "type": "boolean",
            "default": true,
            "description": "When enabled the ascii values will wrap below the hex values if not enough space is available."
          },
          "crumbs.frameHex.rowLength": {
            "type": "integer",
            "default": 16,
            "description": "The number of values to display in a row"
          },
          "crumbs.frameHex.setLength": {
            "type": "integer",
            "default": 8,
            "description": "The number of values to be grouped together into a set within one row"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/lodash": "^4.17.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "ag-grid-react": "^35.0.1",
    "classnames": "^2.5.1",
    "json-rpc-2.0": "^1.7.1",
    "lodash": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tmp": "^0.2.5"
  }
}