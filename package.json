{
  "name": "crumbs",
  "displayName": "Crumbs",
  "description": "Explore packet captures in VS Code with Wireshark display filters, protocol trees, and synchronized hex inspection.",
  "version": "1.3.2",
  "publisher": "lukaschneider",
  "author": "Lukas Schneider",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukaschneider/Crumbs.git"
  },
  "homepage": "https://github.com/lukaschneider/Crumbs#readme",
  "bugs": {
    "url": "https://github.com/lukaschneider/Crumbs/issues"
  },
  "keywords": [
    "pcap",
    "pcapng",
    "wireshark",
    "network",
    "packet",
    "hex",
    "display filter"
  ],
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "crumbsFrameList",
        "displayName": "Frame List",
        "selector": [
          {
            "filenamePattern": "*.cap*"
          },
          {
            "filenamePattern": "*.pcap*"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "crumbsFrameExplorer",
          "title": "Frame Explorer",
          "icon": "$(telescope)"
        }
      ]
    },
    "views": {
      "crumbsFrameExplorer": [
        {
          "id": "crumbsFrameTreeWelcome",
          "contextualTitle": "Frame Explorer",
          "name": "Tree",
          "icon": "$(list-tree)",
          "type": "webview",
          "when": "openDocumentCount > 0 && !crumbs.hasProtocolTree"
        },
        {
          "id": "crumbsFrameTree",
          "contextualTitle": "Frame Explorer",
          "name": "Tree",
          "icon": "$(list-tree)",
          "type": "tree",
          "when": "openDocumentCount > 0 && crumbs.hasProtocolTree"
        },
        {
          "id": "crumbsFrameHex",
          "contextualTitle": "Frame Explorer",
          "name": "Hex",
          "icon": "$(file-binary)",
          "type": "webview",
          "when": "openDocumentCount > 0"
        }
      ]
    },
    "configuration": [
      {
        "title": "Crumbs",
        "properties": {
          "crumbs.sharkd": {
            "type": "string",
            "default": "",
            "description": "Path to the sharkd executable. Leave empty to detect Wireshark in standard Windows installation folders, then fall back to sharkd on PATH. An explicit custom path always takes precedence.",
            "scope": "machine"
          },
          "crumbs.wireshark": {
            "type": "string",
            "default": "wireshark",
            "description": "Path to the wireshark binary.",
            "scope": "machine"
          },
          "crumbs.profile": {
            "type": "string",
            "default": "",
            "description": "Wireshark configuration profile to use. Leave empty to use the default profile.",
            "scope": "machine"
          },
          "crumbs.frameList.columns": {
            "type": "object",
            "default": {
              "Number": "%m",
              "Time": "%t",
              "Source": "%s",
              "Destination": "%d",
              "Protocol": "%p",
              "Length": "%L",
              "Info": "%i"
            },
            "examples": [
              {
                "Number": "%m",
                "Time": "%t",
                "Source": "%s",
                "Destination": "%d",
                "Protocol": "%p",
                "Length": "%L",
                "Info": "%i"
              }
            ],
            "markdownDescription": "The columns to be displayed in the frame list.\n\n**Note:** Run `tshark -G column-formats` to see available field types or use a display filter field. See available fields here: https://www.wireshark.org/docs/dfref/. If you need to add field occurrence you can do so by adding \":`occurrence`\".",
            "additionalProperties": {
              "type": "string",
              "description": "Key is the column title and value is the field type or expression."
            }
          },
          "crumbs.frameList.colorCoding": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Use Wireshark's packet coloring rules. Hovered and selected rows use the VS Code theme's colors for readability."
          },
          "crumbs.frameHex.enableRowWrap": {
            "type": "boolean",
            "default": true,
            "description": "When enabled the ascii values will wrap below the hex values if not enough space is available."
          },
          "crumbs.frameHex.rowLength": {
            "type": "integer",
            "default": 16,
            "description": "The number of values to display in a row",
            "minimum": 1,
            "maximum": 256
          },
          "crumbs.frameHex.setLength": {
            "type": "integer",
            "default": 8,
            "description": "The number of values to be grouped together into a set within one row",
            "minimum": 1,
            "maximum": 256
          }
        }
      }
    ],
    "commands": [
      {
        "command": "crumbs.filter.apply.selected",
        "title": "Selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.apply.not",
        "title": "Not selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.apply.and",
        "title": "…and selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.apply.or",
        "title": "…or selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.apply.and-not",
        "title": "…and not selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.apply.or-not",
        "title": "…or not selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.prepare.selected",
        "title": "Selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.prepare.not",
        "title": "Not selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.prepare.and",
        "title": "…and selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.prepare.or",
        "title": "…or selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.prepare.and-not",
        "title": "…and not selected",
        "category": "Crumbs"
      },
      {
        "command": "crumbs.filter.prepare.or-not",
        "title": "…or not selected",
        "category": "Crumbs"
      }
    ],
    "submenus": [
      {
        "id": "crumbs.filter.apply",
        "label": "Apply as filter"
      },
      {
        "id": "crumbs.filter.prepare",
        "label": "Prepare as filter"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "submenu": "crumbs.filter.apply",
          "when": "view == crumbsFrameTree && viewItem == crumbsFilterable",
          "group": "filter@1"
        },
        {
          "submenu": "crumbs.filter.prepare",
          "when": "view == crumbsFrameTree && viewItem == crumbsFilterable",
          "group": "filter@2"
        }
      ],
      "commandPalette": [
        {
          "command": "crumbs.filter.apply.selected",
          "when": "false"
        },
        {
          "command": "crumbs.filter.apply.not",
          "when": "false"
        },
        {
          "command": "crumbs.filter.apply.and",
          "when": "false"
        },
        {
          "command": "crumbs.filter.apply.or",
          "when": "false"
        },
        {
          "command": "crumbs.filter.apply.and-not",
          "when": "false"
        },
        {
          "command": "crumbs.filter.apply.or-not",
          "when": "false"
        },
        {
          "command": "crumbs.filter.prepare.selected",
          "when": "false"
        },
        {
          "command": "crumbs.filter.prepare.not",
          "when": "false"
        },
        {
          "command": "crumbs.filter.prepare.and",
          "when": "false"
        },
        {
          "command": "crumbs.filter.prepare.or",
          "when": "false"
        },
        {
          "command": "crumbs.filter.prepare.and-not",
          "when": "false"
        },
        {
          "command": "crumbs.filter.prepare.or-not",
          "when": "false"
        }
      ],
      "crumbs.filter.apply": [
        {
          "command": "crumbs.filter.apply.selected",
          "group": "0_replace@0"
        },
        {
          "command": "crumbs.filter.apply.not",
          "group": "0_replace@1"
        },
        {
          "command": "crumbs.filter.apply.and",
          "group": "1_combine@2"
        },
        {
          "command": "crumbs.filter.apply.or",
          "group": "1_combine@3"
        },
        {
          "command": "crumbs.filter.apply.and-not",
          "group": "1_combine@4"
        },
        {
          "command": "crumbs.filter.apply.or-not",
          "group": "1_combine@5"
        }
      ],
      "crumbs.filter.prepare": [
        {
          "command": "crumbs.filter.prepare.selected",
          "group": "0_replace@0"
        },
        {
          "command": "crumbs.filter.prepare.not",
          "group": "0_replace@1"
        },
        {
          "command": "crumbs.filter.prepare.and",
          "group": "1_combine@2"
        },
        {
          "command": "crumbs.filter.prepare.or",
          "group": "1_combine@3"
        },
        {
          "command": "crumbs.filter.prepare.and-not",
          "group": "1_combine@4"
        },
        {
          "command": "crumbs.filter.prepare.or-not",
          "group": "1_combine@5"
        }
      ]
    }
  },
  "scripts": {
    "demo:capture": "node scripts/generateDemoCapture.js",
    "demo:media": "node scripts/buildMedia.js",
    "demo:record": "node scripts/recordShowcase.js",
    "vscode:prepublish": "npm run package",
    "compile": "node scripts/build.js",
    "watch": "node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node scripts/build.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run check-types && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "watch:webview": "tsc --noEmit --watch --project src/webview/tsconfig.json",
    "lint:fix": "biome lint --write src test",
    "test:watch": "vitest",
    "test:integration": "node scripts/testIntegration.js",
    "pretest:integration": "npm run compile-tests && npm run compile",
    "test:webview": "playwright test",
    "pretest:webview": "npm run compile-tests && npm run compile"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.108.1",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "json-rpc-2.0": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
